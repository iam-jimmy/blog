---
/** Two dots and a dash — a quiet cursor in front of the name. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<svg
  class={className}
  viewBox="0 0 24 24"
  fill="currentColor"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Jimmy Kim"
>
  <circle cx="4" cy="12" r="2" />
  <circle cx="11" cy="12" r="2" />
  <rect x="16" y="10.5" width="8" height="3" rx="1.5" />
</svg>
