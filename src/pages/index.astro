---
import Base from '../layouts/Base.astro';
import { getPublishedPosts, postUrl, formatDate } from '../utils/posts';

const posts = await getPublishedPosts();
---
<Base>
    <section>
        <div class="container">
            <div class="intro">
                <p>Notes on what I build, break, and learn along the way</p>
                <p>Mostly about servers, infrastructure, and the occasional detour</p>
            </div>
        </div>
    </section>
    <section>
        <div class="container">
            {posts.length === 0 ? (
                <p class="posts__empty">Nothing written yet.</p>
            ) : (
                <div class="posts">
                    {posts.map((post) => (
                        <a href={postUrl(post.id)}>
                            <div class="body">
                                <p class="title">{post.data.title}</p>
                                <p class="desc">{post.data.description}</p>
                            </div>
                            <div class="meta">
                                <span>{formatDate(post.data.pubDate)}</span>
                            </div>
                        </a>
                    ))}
                </div>
            )}
        </div>
    </section>
</Base>
